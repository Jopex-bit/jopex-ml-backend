# Copiá este archivo a ".env" y completá con tus datos reales.
# NUNCA subas el archivo ".env" a un repositorio público — solo se usa en el
# hosting donde desplegás el servidor (Render, Railway, etc.), configurado
# como "Environment Variables" desde el panel de esa plataforma, no como archivo.

# Client ID y Client Secret que te dio Mercado Libre al crear la Aplicación
ML_CLIENT_ID=tu_client_id_aca
ML_CLIENT_SECRET=tu_client_secret_aca

# Debe coincidir EXACTO con la Redirect URI configurada en tu Aplicación de ML.
# Una vez desplegado el servidor, va a ser algo como:
# https://tu-app.onrender.com/auth/callback
ML_REDIRECT_URI=https://jopex-ml-backend.onrender.com/auth/callback

# Un texto secreto inventado por vos, para proteger la ruta que dispara el login.
# Cambialo por cualquier cadena larga y aleatoria.
APP_SECRET=cambiame-por-algo-largo-y-aleatorio

# Puerto en el que corre el servidor (la mayoría de los hostings lo asignan solos)
PORT=3000
